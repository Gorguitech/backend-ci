# Modele de configuration. Copier en .env (ignore par Git) et remplacer chaque valeur.
# Aucune valeur de ce fichier ne doit etre utilisee telle quelle en dehors du poste de developpement.

# --- Fuseau horaire des conteneurs ---
TZ=Africa/Dakar

# --- PostgreSQL : compte d'administration du conteneur (sert uniquement a l'initialisation) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=changer-moi
# Port publie sur la machine hote (5432 est souvent deja pris par une autre instance)
POSTGRES_HOST_PORT=5433

# --- PostgreSQL : une base et un utilisateur par service ---
AUTH_DB_PASSWORD=changer-moi
ENFANT_DB_PASSWORD=changer-moi
PERSONNEL_DB_PASSWORD=changer-moi
PAIEMENT_DB_PASSWORD=changer-moi
COMPTABILITE_DB_PASSWORD=changer-moi
AUDIT_DB_PASSWORD=changer-moi

# --- RabbitMQ (audit uniquement) ---
RABBITMQ_USER=internatadmin
RABBITMQ_PASSWORD=changer-moi
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# --- JWT RS256 : generer avec scripts/generate-jwt-keys.sh (PEM encode en base64, une ligne) ---
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_EXPIRATION_MINUTES=480

# --- Appels inter-services sur /internal/** (chaine aleatoire, par exemple : openssl rand -hex 32) ---
INTERNAL_API_KEY=changer-moi

# --- Gateway : origines autorisees par CORS, separees par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- auth-service ---
# Hash BCrypt du mot de passe initial du compte admin (changement force a la premiere connexion).
# Utilise uniquement a la creation du compte, quand aucun compte ADMIN n'existe.
# Generation : ./scripts/hash-admin-password.sh
# Toujours entre apostrophes simples : sinon Docker Compose et le shell interpretent les $ du hash.
ADMIN_INITIAL_PASSWORD_HASH=
# Dossier du logo de l'etablissement (monte sur un volume Docker)
LOGO_DIR=/data/logos

# --- Docker Compose ---
# Port publie de la gateway (URL du frontend : http://localhost:8080/api)
GATEWAY_HOST_PORT=8080
# Tag des images construites localement : internatadmin-backend:<service>-<IMAGE_TAG>
IMAGE_TAG=local
